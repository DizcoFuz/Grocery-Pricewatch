# ── Grocery Pricewatch ──────────────────────────────────────
# Copy to .env and adjust as needed.

# App
APP_PORT=8000
# Default ZIP code for initial store seeding (editable per-store in UI later)
DEFAULT_ZIP=60601
# Optional shared password for hosted deployments (blank = no auth)
APP_PASSWORD=

# SQLite DB path (inside the app container; volume-mapped)
DB_PATH=/data/grocery.db

# Raw payload archive (90-day retention)
DATA_DIR=/data

# Tesseract OCR server (for Woodman's image/PDF circulars)
TESSERACT_URL=http://tesseract:8080/ocr

# Playwright headless browser service (for JS-rendered ad pages)
BROWSER_URL=http://browserless:3000

# Scheduler
REFRESH_TIME=07:00
# Comma-separated ad-flip days: mon,tue,wed,thu,fri,sat,sun
AD_FLIP_DAYS=wed,sun

# Logging
LOG_LEVEL=INFO
